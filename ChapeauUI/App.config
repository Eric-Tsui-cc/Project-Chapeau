<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<connectionStrings>
		<!-- Option 1: SQL Server LocalDB (recommended for local dev) -->
		<add name="RestuarantProjectGroup4"
             connectionString="Data Source=(LocalDB)\MSSQLLocalDB;AttachDbFilename=|DataDirectory|\RestuarantProjectGroup4.mdf;Integrated Security=True;Connect Timeout=30"
             providerName="System.Data.SqlClient" />

		<!-- Option 2: SQL Server Express (uncomment and adjust if using full SQL Server) -->
		<!--
		<add name="RestuarantProjectGroup4"
             connectionString="Data Source=.\SQLEXPRESS;Initial Catalog=RestuarantProjectGroup4;Integrated Security=True;TrustServerCertificate=True"
             providerName="System.Data.SqlClient" />
		-->

		<!-- Option 3: Azure SQL (uncomment and fill in for cloud) -->
		<!--
		<add name="RestuarantProjectGroup4"
             connectionString="Data Source=yourserver.database.windows.net;Initial Catalog=RestuarantProjectGroup4;User ID=youruser;Password=yourpassword;Encrypt=True;TrustServerCertificate=False"
             providerName="System.Data.SqlClient" />
		-->
	</connectionStrings>
</configuration>
